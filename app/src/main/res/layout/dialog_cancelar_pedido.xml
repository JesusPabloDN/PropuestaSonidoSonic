<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/spacing_large">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_quien_cancela"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleQuienCancela"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:layout_marginBottom="@dimen/spacing_medium"
        app:checkedButton="@id/btnCancelaCliente"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelaCliente"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quien_cancela_cliente" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelaSocios"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/quien_cancela_socios" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Resumen del reembolso calculado -->
    <TextView
        android:id="@+id/tvReembolsoCalculado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:background="?attr/colorSurfaceVariant"
        android:padding="@dimen/spacing_medium"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        tools:text="Reembolso a realizar: $1,050.00" />

    <!-- Motivo de cancelación -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilMotivoCancelacion"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/label_motivo_cancelacion">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMotivoCancelacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
