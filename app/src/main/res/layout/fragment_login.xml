<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_xlarge"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingBottom="@dimen/spacing_xlarge">

        <!-- Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:contentDescription="@string/desc_logo"
            android:src="@drawable/sonidosonic" />

        <!-- Selector de rol por pestañas -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutRol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:tabGravity="fill"
            app:tabIndicatorFullWidth="true"
            app:tabMode="fixed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:text="@string/login_titulo"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_headline"
            android:textStyle="bold" />

        <!-- Campo Correo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/hint_correo"
            app:boxBackgroundMode="outline"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:minHeight="@dimen/touch_target_min"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:hint="@string/hint_contrasena"
            app:boxBackgroundMode="outline"
            app:endIconMode="password_toggle"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:minHeight="@dimen/touch_target_min"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón Iniciar Sesión (Único botón) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="@string/btn_iniciar_sesion"
            android:textSize="@dimen/text_body" />

        <!-- Enlace a Registro (visible solo para Cliente) -->
        <TextView
            android:id="@+id/tvIrARegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:gravity="center"
            android:padding="@dimen/spacing_small"
            android:text="@string/link_ir_a_registro"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_body" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
