<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large">

        <!-- Aviso si no hay paquetes -->
        <TextView
            android:id="@+id/tvAvisoSinPaquetes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:background="?attr/colorSurfaceVariant"
            android:padding="@dimen/spacing_medium"
            android:text="@string/label_aviso_sin_paquetes"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 1. Paquete -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPaquete"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/label_paquete">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvPaquete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2. Duración -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDuracion"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/label_duracion">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvDuracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 3. Fecha -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_fecha_evento"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeleccionarFecha"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minHeight="@dimen/button_height"
            android:text="@string/label_fecha_evento"
            android:textAlignment="viewStart"
            app:icon="@drawable/ic_calendar_month_24" />

        <!-- 4. Horarios disponibles -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_horarios_disponibles"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupHorarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:layout_marginBottom="@dimen/spacing_small"
            app:singleSelection="true" />

        <!-- Sin horarios y alternativas -->
        <LinearLayout
            android:id="@+id/layoutSinHorarios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_no_horarios_disponibles"
                android:textColor="?attr/colorError"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="@string/label_alternativas_disponibles"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAlternativas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny" />

        </LinearLayout>

        <!-- 5. Resumen en vivo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResumenEnVivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_resumen_pedido"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvResumenFin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body"
                    tools:text="Fin del evento: 23:00" />

                <TextView
                    android:id="@+id/tvResumenMontaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    tools:text="Montaje desde: 17:30" />

                <TextView
                    android:id="@+id/tvResumenDesmontaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp"
                    tools:text="Desmontaje hasta: 01:00" />

                <TextView
                    android:id="@+id/tvResumenPersonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body"
                    tools:text="Personal asignado: Carlos (Socio)" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:layout_marginBottom="@dimen/spacing_small"
                    android:background="?attr/colorSurfaceVariant" />

                <TextView
                    android:id="@+id/tvResumenTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    tools:text="Total: $3,500.00" />

                <TextView
                    android:id="@+id/tvResumenAnticipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    tools:text="Anticipo requerido (30%): $1,050.00" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 6. Datos del evento y cliente -->
        <!-- Nombre del evento -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombreEvento"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/label_nombre_evento"
            app:counterEnabled="true"
            app:counterMaxLength="80">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombreEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="80" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nombre del cliente -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombreCliente"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/label_nombre_cliente">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/etNombreCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Teléfono -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTelefonoCliente"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/label_telefono_cliente">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTelefonoCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dirección -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDireccion"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/label_direccion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDireccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress|textCapSentences" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notas adicionales -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNotas"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:hint="@string/label_notas_adicionales">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 7. Cómo llegó el pedido -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_origen_pedido"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleOrigen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:layout_marginBottom="@dimen/spacing_medium"
            app:checkedButton="@id/btnOrigenLlamada"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrigenLlamada"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/origen_llamada" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrigenWhatsapp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/origen_whatsapp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrigenPresencial"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/origen_presencial" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- 8. Retener el apartado por -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRetenerHoras"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:hint="@string/label_retener_apartado">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvRetenerHoras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 9. Botón Apartar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApartar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:minHeight="@dimen/button_height"
            android:text="@string/btn_apartar" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
