<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardEquipo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_medium"
    android:layout_marginEnd="@dimen/spacing_medium"
    android:layout_marginBottom="@dimen/spacing_small"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorSurfaceVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_small"
        android:minHeight="@dimen/touch_target_min">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivEquipoFoto"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedImageView72"
            android:contentDescription="@string/nav_inventario"
            tools:src="@drawable/bocinajbl" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_medium"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvNombreUnidad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Bocina JBL 15&quot; (3)" />

                <TextView
                    android:id="@+id/tvEstadoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:textColor="@color/status_disponible"
                    tools:text="Disponible" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCategoriaPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Bocinas · $500 por evento" />

            <TextView
                android:id="@+id/tvProximaReserva"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="Próxima reserva: sáb 15 oct 2026 · Boda de Ana" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
