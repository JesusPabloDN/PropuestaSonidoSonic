<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardEventoAgenda"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_medium"
    android:layout_marginEnd="@dimen/spacing_medium"
    android:layout_marginBottom="@dimen/spacing_small"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorSurfaceVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium"
        android:minHeight="@dimen/touch_target_min"
        android:gravity="center_vertical">

        <!-- Columna izquierda: Rango de Horas -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="92dp"
            android:orientation="vertical"
            android:gravity="start|center_vertical"
            android:layout_marginEnd="@dimen/spacing_small">

            <TextView
                android:id="@+id/tvRangoHorario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="19:00–23:00" />

        </LinearLayout>

        <!-- Divisor vertical sutil -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/spacing_small"
            android:background="?attr/colorSurfaceVariant" />

        <!-- Columna derecha: Detalles del evento -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fila superior: Nombre del evento y Badge de estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNombreEvento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_title"
                    android:textStyle="bold"
                    tools:text="Boda Mariana y Carlos" />

                <TextView
                    android:id="@+id/tvEstadoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:paddingStart="@dimen/spacing_small"
                    android:paddingTop="2dp"
                    android:paddingEnd="@dimen/spacing_small"
                    android:paddingBottom="2dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Confirmado" />

            </LinearLayout>

            <!-- Paquete · Cliente -->
            <TextView
                android:id="@+id/tvPaqueteCliente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="Paquete Básico · Mariana Gómez" />

            <!-- Personal asignado -->
            <TextView
                android:id="@+id/tvPersonalAsignado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                tools:text="Personal: Jesús Pablo (Socio)" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
