<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target_min"
    android:paddingTop="@dimen/spacing_tiny"
    android:paddingBottom="@dimen/spacing_tiny">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvComponenteNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            tools:text="Bocina JBL 15&quot;" />

        <TextView
            android:id="@+id/tvComponenteStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Bocinas · Hay 4 en inventario" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnComponenteMenos"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_remove_24"
        android:contentDescription="@string/desc_disminuir_cantidad"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvComponenteCantidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:gravity="center"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        tools:text="2" />

    <ImageButton
        android:id="@+id/btnComponenteMas"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_add_24"
        android:contentDescription="@string/desc_aumentar_cantidad"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/btnComponenteQuitar"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_delete_24"
        android:contentDescription="@string/desc_quitar_componente"
        app:tint="@color/status_danado" />

</LinearLayout>
