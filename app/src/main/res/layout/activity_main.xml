<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Contenido principal -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior de la app -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:minHeight="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:titleTextColor="?attr/colorOnSurface"
            app:navigationIconTint="?attr/colorOnSurface" />

        <!-- Host de Fragmentos de Navegación -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />

        <!-- Barra de navegación inferior (solo en los 5 destinos principales de Socio) -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:menu="@menu/bottom_menu" />

    </LinearLayout>

    <!-- Panel lateral (Drawer) -->
    <LinearLayout
        android:id="@+id/drawerView"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <!-- Encabezado con datos del usuario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_large"
            android:paddingTop="@dimen/spacing_small"
            android:paddingEnd="@dimen/spacing_large"
            android:paddingBottom="@dimen/spacing_large">

            <TextView
                android:id="@+id/tvDrawerUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre de Usuario"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDrawerUserRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="Rol"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Opción superior: Equipo de trabajo (visible solo para Socio) -->
        <LinearLayout
            android:id="@+id/drawerItemEquipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivDrawerEquipoIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/menu_equipo_trabajo"
                android:src="@drawable/ic_group_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvDrawerEquipoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:text="@string/menu_equipo_trabajo"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

        <!-- Espacio flexible para empujar las opciones al fondo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Opción 1: Modo oscuro / Modo claro -->
        <LinearLayout
            android:id="@+id/drawerItemTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large">

            <ImageView
                android:id="@+id/ivDrawerThemeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/desc_toggle_tema"
                android:src="@drawable/ic_dark_mode_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvDrawerThemeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:text="@string/menu_modo_oscuro"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

        <!-- Opción 2: Cerrar sesión -->
        <LinearLayout
            android:id="@+id/drawerItemLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_large"
            android:paddingEnd="@dimen/spacing_large">

            <ImageView
                android:id="@+id/ivDrawerLogoutIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/desc_cerrar_sesion"
                android:src="@drawable/ic_logout_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvDrawerLogoutLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_medium"
                android:text="@string/menu_cerrar_sesion"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>