<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Pantalla de Login (Inicio) -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.propuestasonidosonic.ui.auth.LoginFragment"
        android:label="@string/login_titulo"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_login_to_socio_graph"
            app:destination="@id/socio_graph"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_login_to_cliente_graph"
            app:destination="@id/cliente_graph"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_login_to_asistente_graph"
            app:destination="@id/asistente_graph"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Pantalla de Registro -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.propuestasonidosonic.ui.auth.RegisterFragment"
        android:label="@string/registro_titulo"
        tools:layout="@layout/fragment_register" />

    <!-- Grafo de Socio -->
    <navigation
        android:id="@+id/socio_graph"
        app:startDestination="@id/nav_dashboard">

        <fragment
            android:id="@+id/nav_dashboard"
            android:name="com.example.propuestasonidosonic.ui.socio.DashboardFragment"
            android:label="@string/nav_dashboard"
            tools:layout="@layout/fragment_dashboard" />

        <fragment
            android:id="@+id/nav_inventario"
            android:name="com.example.propuestasonidosonic.ui.socio.InventarioFragment"
            android:label="@string/nav_inventario"
            tools:layout="@layout/fragment_inventario">
            <action
                android:id="@+id/action_inventario_to_paqueteForm"
                app:destination="@id/paqueteFormFragment" />
        </fragment>

        <fragment
            android:id="@+id/paqueteFormFragment"
            android:name="com.example.propuestasonidosonic.ui.socio.PaqueteFormFragment"
            android:label="@string/paquete_form_titulo_nuevo"
            tools:layout="@layout/fragment_paquete_form">
            <argument
                android:name="paqueteId"
                app:argType="string"
                app:nullable="true"
                android:defaultValue="@null" />
        </fragment>

        <fragment
            android:id="@+id/nav_agenda"
            android:name="com.example.propuestasonidosonic.ui.socio.AgendaFragment"
            android:label="@string/nav_agenda"
            tools:layout="@layout/fragment_agenda">
            <action
                android:id="@+id/action_agenda_to_detalle"
                app:destination="@id/pedidoDetalleFragment" />
        </fragment>

        <fragment
            android:id="@+id/nav_pedidos"
            android:name="com.example.propuestasonidosonic.ui.socio.PedidosFragment"
            android:label="@string/nav_pedidos"
            tools:layout="@layout/fragment_pedidos">
            <action
                android:id="@+id/action_pedidos_to_nuevoPedido"
                app:destination="@id/nuevoPedidoFragment" />
            <action
                android:id="@+id/action_pedidos_to_detalle"
                app:destination="@id/pedidoDetalleFragment" />
        </fragment>

        <fragment
            android:id="@+id/nuevoPedidoFragment"
            android:name="com.example.propuestasonidosonic.ui.socio.NuevoPedidoFragment"
            android:label="@string/titulo_nuevo_pedido"
            tools:layout="@layout/fragment_nuevo_pedido">
            <action
                android:id="@+id/action_nuevoPedido_to_detalle"
                app:destination="@id/pedidoDetalleFragment"
                app:popUpTo="@id/nuevoPedidoFragment"
                app:popUpToInclusive="true" />
        </fragment>

        <fragment
            android:id="@+id/pedidoDetalleFragment"
            android:name="com.example.propuestasonidosonic.ui.socio.PedidoDetalleFragment"
            android:label="@string/titulo_pedido_detalle"
            tools:layout="@layout/fragment_pedido_detalle">
            <argument
                android:name="pedidoId"
                app:argType="string" />
            <action
                android:id="@+id/action_detalle_to_cliente"
                app:destination="@id/clienteDetalleFragment" />
        </fragment>

        <fragment
            android:id="@+id/nav_finanzas"
            android:name="com.example.propuestasonidosonic.ui.socio.FinanzasFragment"
            android:label="@string/nav_finanzas"
            tools:layout="@layout/fragment_finanzas">
            <action
                android:id="@+id/action_finanzas_to_detalle"
                app:destination="@id/pedidoDetalleFragment" />
        </fragment>

        <fragment
            android:id="@+id/usuariosFragment"
            android:name="com.example.propuestasonidosonic.ui.socio.UsuariosFragment"
            android:label="@string/titulo_equipo_trabajo"
            tools:layout="@layout/fragment_usuarios" />

        <fragment
            android:id="@+id/clientesFragment"
            android:name="com.example.propuestasonidosonic.ui.socio.ClientesFragment"
            android:label="@string/titulo_clientes"
            tools:layout="@layout/fragment_clientes">
            <action
                android:id="@+id/action_clientes_to_cliente"
                app:destination="@id/clienteDetalleFragment" />
        </fragment>

        <fragment
            android:id="@+id/clienteDetalleFragment"
            android:name="com.example.propuestasonidosonic.ui.socio.ClienteDetalleFragment"
            android:label="@string/titulo_cliente_detalle"
            tools:layout="@layout/fragment_cliente_detalle">
            <argument
                android:name="clienteKey"
                app:argType="string" />
            <action
                android:id="@+id/action_cliente_to_pedido"
                app:destination="@id/pedidoDetalleFragment" />
        </fragment>

    </navigation>

    <!-- Grafo de Cliente -->
    <navigation
        android:id="@+id/cliente_graph"
        app:startDestination="@id/clienteHomeFragment">

        <fragment
            android:id="@+id/clienteHomeFragment"
            android:name="com.example.propuestasonidosonic.ui.cliente.ClienteHomeFragment"
            android:label="@string/nav_catalogo"
            tools:layout="@layout/fragment_cliente_home">
            <action
                android:id="@+id/action_clienteHome_to_paqueteDetalle"
                app:destination="@id/paqueteDetalleClienteFragment" />
        </fragment>

        <fragment
            android:id="@+id/nav_cliente_pedidos"
            android:name="com.example.propuestasonidosonic.ui.cliente.ClientePedidosFragment"
            android:label="@string/nav_mis_pedidos"
            tools:layout="@layout/fragment_cliente_pedidos">
            <action
                android:id="@+id/action_clientePedidos_to_detalle"
                app:destination="@id/clientePedidoDetalleFragment" />
            <action
                android:id="@+id/action_clientePedidos_to_pagoAnticipo"
                app:destination="@id/pagoAnticipoFragment" />
        </fragment>

        <fragment
            android:id="@+id/clientePedidoDetalleFragment"
            android:name="com.example.propuestasonidosonic.ui.cliente.ClientePedidoDetalleFragment"
            android:label="@string/titulo_pedido_detalle_cliente"
            tools:layout="@layout/fragment_cliente_pedido_detalle">
            <argument
                android:name="pedidoId"
                app:argType="string" />
            <action
                android:id="@+id/action_clientePedidoDetalle_to_pagoAnticipo"
                app:destination="@id/pagoAnticipoFragment" />
        </fragment>

        <fragment
            android:id="@+id/paqueteDetalleClienteFragment"
            android:name="com.example.propuestasonidosonic.ui.cliente.PaqueteDetalleClienteFragment"
            android:label="@string/nav_catalogo"
            tools:layout="@layout/fragment_paquete_detalle_cliente">
            <argument
                android:name="paqueteId"
                app:argType="string" />
            <action
                android:id="@+id/action_paqueteDetalle_to_reservar"
                app:destination="@id/reservarFragment" />
        </fragment>

        <fragment
            android:id="@+id/reservarFragment"
            android:name="com.example.propuestasonidosonic.ui.cliente.ReservarFragment"
            android:label="@string/titulo_reservar"
            tools:layout="@layout/fragment_reservar">
            <argument
                android:name="paqueteId"
                app:argType="string" />
            <action
                android:id="@+id/action_reservar_to_pagoAnticipo"
                app:destination="@id/pagoAnticipoFragment"
                app:popUpTo="@id/reservarFragment"
                app:popUpToInclusive="true" />
        </fragment>

        <fragment
            android:id="@+id/pagoAnticipoFragment"
            android:name="com.example.propuestasonidosonic.ui.cliente.PagoAnticipoFragment"
            android:label="@string/titulo_pago_anticipo"
            tools:layout="@layout/fragment_pago_anticipo">
            <argument
                android:name="pedidoId"
                app:argType="string" />
            <action
                android:id="@+id/action_pagoAnticipo_to_clienteHome"
                app:destination="@id/clienteHomeFragment"
                app:popUpTo="@id/clienteHomeFragment"
                app:popUpToInclusive="false" />
            <action
                android:id="@+id/action_pagoAnticipo_to_clientePedidos"
                app:destination="@id/nav_cliente_pedidos"
                app:popUpTo="@id/clienteHomeFragment"
                app:popUpToInclusive="false" />
        </fragment>

    </navigation>

    <!-- Grafo de Asistente -->
    <navigation
        android:id="@+id/asistente_graph"
        app:startDestination="@id/asistenteHomeFragment">

        <fragment
            android:id="@+id/asistenteHomeFragment"
            android:name="com.example.propuestasonidosonic.ui.asistente.AsistenteHomeFragment"
            android:label="@string/nav_asistente_eventos"
            tools:layout="@layout/fragment_asistente_home">
            <action
                android:id="@+id/action_asistenteHome_to_detalle"
                app:destination="@id/asistenteEventoDetalleFragment" />
        </fragment>

        <fragment
            android:id="@+id/nav_asistente_disponibilidad"
            android:name="com.example.propuestasonidosonic.ui.asistente.AsistenteDisponibilidadFragment"
            android:label="@string/nav_asistente_disponibilidad"
            tools:layout="@layout/fragment_asistente_disponibilidad" />

        <fragment
            android:id="@+id/asistenteEventoDetalleFragment"
            android:name="com.example.propuestasonidosonic.ui.asistente.AsistenteEventoDetalleFragment"
            android:label="@string/titulo_evento_detalle_asistente"
            tools:layout="@layout/fragment_asistente_evento_detalle">
            <argument
                android:name="pedidoId"
                app:argType="string" />
        </fragment>

    </navigation>

</navigation>
